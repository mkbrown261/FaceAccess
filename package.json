{
  "name": "faceaccess",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply faceaccess-production --local --config wrangler.jsonc",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:migrate:prod": "wrangler d1 migrations apply faceaccess-production --config wrangler.jsonc",
    "start": "pm2 start ecosystem.config.cjs",
    "test:e2e": "bash scripts/e2e.sh",
    "test:ui": "python3 scripts/ui_smoke.py",
    "test:camera": "python3 scripts/camera_flow.py",
    "test:faces": "python3 scripts/face_matrix.py && python3 scripts/real_face_e2e.py"
  },
  "dependencies": {
    "hono": "^4.12.7"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
